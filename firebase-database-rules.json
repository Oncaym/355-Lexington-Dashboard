{
  "rules": {
    // ---------- 全局默认：拒绝 ----------
    ".read":  false,
    ".write": false,

    // ---------- 业务数据：state（项目状态） ----------
    // 读：任何登录用户（包括非 editor，用来给主 tracker 和 chat 看数据）
    // 写：仅 allowlist 内的 editor
    "state": {
      // 读：allowlist（编辑）或 gcList（总包）。
      //   ⚠ 2026-09-17 之前这里是 "auth != null" —— 这个 Firebase 项目里**任何**登录账号
      //   都能读走整个工地的数据，而且前端会把他当成 GC（narrowed view + 能以 source:'gc'
      //   提条目）。真正的边界在这一行，不在前端的遮罩。
      //   最后那个 !exists() 是灰度开关：/gcList 还没建之前保持旧行为，建好当天开始生效，
      //   和 cloud-sync.js 里的 gcListConfigured 完全对应。
      ".read":  "auth != null && (root.child('allowlist').child(auth.token.email.replace('.', ',')).exists() || root.child('gcList').child(auth.token.email.replace('.', ',')).exists() || !root.child('gcList').exists())",
      ".write": "auth != null && root.child('allowlist').child(auth.token.email.replace('.', ',')).exists()",
      ".validate": "newData.hasChildren(['_clientId', '_ts', '_by'])"
    },

    // ---------- 总包名单 (GC list) ----------
    // 谁是 GC 必须是**被点名的**，不能是"不在 allowlist 里就算"。
    // 读：任何登录用户 —— 前端要能分辨"这个节点还没建"（灰度）和"建了但我不在里面"
    //     （= 没有权限）。代价是登录用户能看到 GC 的邮箱列表，可以接受。
    // 写：只在 Firebase Console 里改。键是邮箱把 '.' 全换成 ','，值随便（true 即可）：
    //     { "gcList": { "pm@broadwaybuilder,com": true } }
    "gcList": {
      ".read":  "auth != null",
      ".write": false
    },

    // ---------- 周五到货调度 (Friday glass delivery triage) ----------
    // 读：任何登录用户
    // 写：仅 editor。每件玻璃存在 /triage/{deliveryId}/pieces/{tagKey}
    "triage": {
      ".read":  "auth != null",
      "$deliveryId": {
        "pieces": {
          ".write": "auth != null && root.child('allowlist').child(auth.token.email.replace('.', ',')).exists()",
          "$tagKey": {
            ".validate": "newData.hasChild('status')"
          }
        },
        "meta": {
          ".write": "auth != null && root.child('allowlist').child(auth.token.email.replace('.', ',')).exists()"
        }
      }
    },

    // ---------- 仓库 (Warehouse — Stage 1: Receive) ----------
    // 读：任何登录用户
    // 写 / 改 / 删：任何 editor（小团队信任模型，任何人都能改/删任何条）
    //   - 创建：必须带 4 个必填字段
    //   - 更新：同上（receivedBy 不强制等于当前 user，允许 A 修正 B 录入的条）
    //   - 删除：write=null 时 validate 不跑，自动允许
    //   ⇒ Stage 2 上线"出货"时会另开 warehouse/shipments 子树存出货事件
    "warehouse": {
      ".read": "auth != null",
      "items": {
        ".indexOn": ["receivedAt"],
        "$itemId": {
          ".write": "auth != null && root.child('allowlist').child(auth.token.email.replace('.', ',')).exists()",
          ".validate": "newData.hasChildren(['where','receivedAt','receivedBy','status']) && newData.child('status').val() == 'in_stock'"
        }
      }
    },

    // ---------- 编辑历史 ----------
    // 读：任何登录用户
    // 写（追加）：仅 editor，且 user 字段必须等于自己的邮箱
    "history": {
      ".read": "auth != null",
      "$pushId": {
        ".write": "auth != null && !data.exists() && root.child('allowlist').child(auth.token.email.replace('.', ',')).exists()",
        ".validate": "newData.hasChildren(['ts','user','desc']) && newData.child('user').val() == auth.token.email"
      }
    },

    // ---------- 在线状态 ----------
    // 读：任何登录用户
    // 写：仅 editor 且只能写自己那条
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid && root.child('allowlist').child(auth.token.email.replace('.', ',')).exists()",
        ".validate": "newData.hasChildren(['email','since']) && newData.child('email').val() == auth.token.email"
      }
    },

    // ---------- 访问日志 (F-033 pilot: opens tracking) ----------
    // 写（追加）：任何登录用户（包括非 editor 的 GC 只读账号），只能写自己那条，不能改历史
    // 读：仅 editor（避免把所有访客邮箱暴露给普通登录用户）
    "access": {
      ".read": "auth != null && root.child('allowlist').child(auth.token.email.replace('.', ',')).exists()",
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['email','ts']) && newData.child('email').val() == auth.token.email"
      }
    },

    // ---------- GC 收件箱 (F-037: GC 提问 / 回复) ----------
    // /state 永远只有 editor 能写；GC（非 allowlist）要提事项就写这里。
    // 读：任何登录用户（GC 也要能看到自己提交的条目落地了）
    // 创建：任何登录用户，但 by 必须等于自己的邮箱（防冒名）
    // 修改/删除：仅 editor（triage：merge 进 thread 后标 handled，或清掉）
    "gcItems": {
      ".read": "auth != null",
      ".indexOn": ["ts"],
      "$id": {
        ".write": "auth != null && (!data.exists() || root.child('allowlist').child(auth.token.email.replace('.', ',')).exists())",
        ".validate": "newData.hasChildren(['by','ts','text']) && (data.exists() || newData.child('by').val() == auth.token.email)"
      }
    },

    // ---------- 白名单本身 ----------
    // 整体不可读（防止枚举所有 editor 邮箱）
    // 但允许登录用户读自己那条（用来判断当前账号是不是 editor）
    "allowlist": {
      ".read":  false,
      ".write": false,
      "$emailKey": {
        ".read": "auth != null && auth.token.email.replace('.', ',') == $emailKey"
      }
    }
  }
}
